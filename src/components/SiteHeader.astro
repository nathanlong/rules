---
import { Image } from "astro:assets";
import logo from "~/assets/logo.png";
import { site } from "~/data/site";
import { withBase } from "~/lib/url";

const current = Astro.url.pathname;
---

<header class="pbs-1">
  <div class="container flex justify-between items-center">
    <a class="home heading-300 no-decoration flex items-center" href={withBase("/")}>
      <span class="w-1 rounded-1/4 overflow-hidden line-height-0 mie-1/4">
        <Image class="w-full" src={logo} alt="" width={64} height={64} />
      </span>
      <span>{site.title}</span>
    </a>
    <nav aria-label="Main">
      <ul class="nav flex space-x-1">
        {site.nav.map((item) => {
          const href = withBase(item.href);
          const active = current === href;
          return (
            <li class:list={["nav-item no-list", { "nav-item-active": active }]}>
              <a class="font-monospace no-decoration" href={href} aria-current={active ? "page" : undefined}>
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  </div>
</header>

<style>
  /* Keep the old <h1 class="home"> look now that the site title is a link, not a heading. */
  .home {
    line-height: 1;
    font-weight: bold;
  }
  .w-1 {
    display: block;
  }
  .w-1 :global(img) {
    height: auto;
  }
</style>
