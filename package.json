{
  "name": "Nathan's Rule Repository",
  "version": "1.0.0",
  "description": "Rules on-the-go",
  "type": "module",
  "scripts": {
    "build": "npx @11ty/eleventy --pathprefix '/rules/'",
    "bench": "DEBUG=Eleventy:Benchmark* npx @11ty/eleventy",
    "watch": "npx @11ty/eleventy --watch",
    "serve": "npx @11ty/eleventy --serve",
    "start": "npx @11ty/eleventy --serve",
    "dev": "npx @11ty/eleventy --serve",
    "debug": "DEBUG=* npx @11ty/eleventy"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/nathanlong/rules.git"
  },
  "author": {
    "name": "Nathan Long",
    "email": "nlong5@gmail.com",
    "url": "https://nathan-long.com/rules"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nathanlong/rules/issues"
  },
  "homepage": "https://github.com/nathanlong/rules#readme",
  "dependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@11ty/eleventy-plugin-rss": "^2.0.4",
    "@11ty/eleventy-plugin-syntaxhighlight": "^5.0.2",
    "luxon": "^3.7.2",
    "markdown-it": "^14.1.1",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-deflist": "^3.0.0",
    "markdown-it-mark": "^4.0.0",
    "qrcode": "^1.5.4"
  }
}
