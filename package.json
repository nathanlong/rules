{
  "name": "Nathan's Rule Repository",
  "version": "1.0.0",
  "description": "Rules on-the-go",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "parity": "node scripts/snapshot-urls.mjs dist > tests/parity/astro.json && node scripts/compare-urls.mjs tests/parity/baseline.json tests/parity/astro.json",
    "format": "prettier --write .",
    "deploy": "./bin/deploy.sh"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/nathanlong/rules.git"
  },
  "author": {
    "name": "Nathan Long",
    "email": "nlong5@gmail.com",
    "url": "https://nathan-long.com/rules"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nathanlong/rules/issues"
  },
  "homepage": "https://github.com/nathanlong/rules#readme",
  "dependencies": {
    "@astrojs/markdown-satteri": "^0.4.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/svelte": "^9.0.1",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/pirata-one": "^5.3.0",
    "@fontsource/share-tech-mono": "^5.3.0",
    "astro": "^7.3.8",
    "qrcode": "^1.5.4",
    "satteri": "^0.10.5",
    "slugify": "^1.6.9",
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/qrcode": "^1.5.6",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-svelte": "^4.1.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
